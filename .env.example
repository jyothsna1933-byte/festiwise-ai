# ==========================================
# FestiWise AI - Environment Configuration
# ==========================================
# Copy this file to .env and insert your real Gemini API key.
# NEVER commit the actual .env file or your API keys to version control.

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (supported: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Default Currency symbol/code (INR, USD, EUR, GBP, AUD, CAD)
DEFAULT_CURRENCY=INR

# Application Mode: auto, gemini_only, demo_only
# - auto: uses Gemini if GEMINI_API_KEY is present, falls back gracefully to demo mode if absent
# - gemini_only: strictly requires valid Gemini API key
# - demo_only: always uses pre-configured rich event planning data without API calls
APP_MODE=auto

# Database Path (defaults to SQLite database in project directory)
DATABASE_PATH=festiwise.db
